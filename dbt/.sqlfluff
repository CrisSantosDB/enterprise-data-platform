[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 100
indent_unit = space
tab_space_size = 4

[sqlfluff:indentation]
indented_joins = false
indented_using_on = true
template_blocks_indent = false

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:templater:jinja:macros]
dbt_ref = "{% macro ref(model, v=None) %}dummy_table{% endmacro %}"
dbt_source = "{% macro source(source_name, table_name) %}dummy_source{% endmacro %}"
dbt_config = "{% macro config(materialized=None, unique_key=None, on_schema_change=None, partition_by=None, cluster_by=None, tags=None, schema=None, alias=None, incremental_strategy=None) %}{% endmacro %}"
dbt_is_incremental = "{% macro is_incremental() %}True{% endmacro %}"
dbt_modification_timestamp_expr = "{% macro modification_timestamp_expr() %}CURRENT_TIMESTAMP(){% endmacro %}"
dbt_get_incremental_watermark = "{% macro get_incremental_watermark(col=None) %}AND _source_modified_at > TIMESTAMP('1900-01-01'){% endmacro %}"
dbt_audit_columns = "{% macro audit_columns() %}CURRENT_TIMESTAMP() AS _dbt_loaded_at{% endmacro %}"
tira_acentos = "{% macro tira_acentos(field) %}UPPER({{ field }}){% endmacro %}"
safe_trim = "{% macro safe_trim(field) %}TRIM({{ field }}){% endmacro %}"
normalize_text = "{% macro normalize_text(field) %}TRIM({{ field }}){% endmacro %}"
normalize_upper = "{% macro normalize_upper(field) %}UPPER({{ normalize_text(field) }}){% endmacro %}"
date_spine = "{% macro date_spine(datepart, start_date, end_date) %} SELECT CAST('2026-01-01' AS DATETIME) AS date_day {% endmacro %}"
generate_surrogate_key = "{% macro generate_surrogate_key(field) %} 'mocked_surrogate_key' {% endmacro %}"
safe_divide = {% macro safe_divide(numerator, denominator) -%}SAFE_DIVIDE({{numerator}},{{denominator}}){%endmacro%}
percentage_change = {% macro percentage_change(current_value, previous_value) %} ({{ current_value }} - {{ previous_value }}) / NULLIF({{ previous_value }}, 0) {% endmacro %}